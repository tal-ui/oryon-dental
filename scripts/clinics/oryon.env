# Dr. Liad Oryon — dental clinic (Israel).
#
# Consumed by scripts/bootstrap_clinic.py; every key maps to a field of
# POST /api/v1/auth/setup. Edit freely before the first run: the tax id is
# the 9-digit dealer number (ע.מ / ח.פ) and must be the real one before
# issuing invoices. Timezone / currency / language / VAT (18 %) come from
# the IL country preset, so they are not repeated here.
#
# The admin password is never stored: export CLINIC_ADMIN_PASSWORD or
# type it at the prompt.

CLINIC_NAME='מרפאת שיניים ד"ר ליעד אוריון'
CLINIC_TAX_ID=000000000
CLINIC_COUNTRY=IL
CLINIC_STREET=
CLINIC_CITY=
CLINIC_POSTAL_CODE=

CLINIC_ADMIN_FIRST_NAME=ליעד
CLINIC_ADMIN_LAST_NAME=אוריון
CLINIC_ADMIN_EMAIL=liad@oryon.dental
# She attends patients herself (solo practice): flips is_professional on
# the admin membership so the agenda has a professional from day one.
CLINIC_ADMIN_IS_PROFESSIONAL=true
