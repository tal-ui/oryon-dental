{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nuxtjs",
      "buildCommand": "node scripts/modules-json.mjs ../backend/app/modules --prefix ../backend/app/modules && nuxt build"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": { "service": "backend" } },
    { "source": "/health", "destination": { "service": "backend" } },
    { "source": "/health/(.*)", "destination": { "service": "backend" } },
    { "source": "/", "destination": { "service": "frontend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
